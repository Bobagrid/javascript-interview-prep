//The function returns the second largest number of an array of numbers with length >= 2. It has at least 2 different numbers.

function secondLargest(nums) {
    let actualMax = nums[0];
    let secondMax = -Infinity;
    
    for (let i = 1; i < nums.length; i++) {
    
        if (nums[i] > actualMax) {
            secondMax = actualMax;
            actualMax = nums[i];
            
        } else if (nums[i] < actualMax) {
            secondMax = Math.max(secondMax, nums[i]);
        }
    }
    return secondMax; //returns a number
}
