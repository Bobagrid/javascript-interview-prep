//Function returns the binary version of the decimal number used as parameter
function toBinary(n) { //n is Integer >= 0
    let auxNumber = n;
    let binaryNumber = "";
    while (auxNumber > 1) {
        binaryNumber += auxNumber % 2;
        auxNumber = Math.floor(auxNumber / 2);
    }
    binaryNumber += auxNumber % 2;
    return binaryNumber.split("").reverse().join(""); //function returns a binary String
}

