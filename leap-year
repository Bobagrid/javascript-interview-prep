//The function returns if year is a leap year. Return type is boolean.
function isLeapYear(year) {
    if (year % 4 === 0) {
        if (year % 100 === 0) {
            if (year % 400 === 0) {
                return true;
            } else {
                return false;
            }
        }
        return true;
    }
    return false;
}
